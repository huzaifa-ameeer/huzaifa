# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Local server port. Render supplies PORT automatically; do not set it there.
PORT=8001

# Comma-separated list of origins allowed to call the API (the Vercel frontend URL).
# Leave empty to allow any origin during local development.
CORS_ORIGIN=http://localhost:3001
